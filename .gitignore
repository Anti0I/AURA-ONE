# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# aura-one
#
# The ~100 MB of master PNGs stay out of git: they are reproducible with
# `npm run assets:prerender`. The *encoded* output (6.4 MB) is committed, so a
# clone can build and deploy without a headless render in the pipeline.
/assets-src/out/
/test-results/
/playwright-report/
/.lighthouseci/
/shots/
